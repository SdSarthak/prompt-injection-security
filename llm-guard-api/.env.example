# Gemini API Configuration
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Classifier backend: baseline (TF-IDF + logistic regression) or transformer (DeBERTa)
CLASSIFIER_BACKEND=baseline

# Model paths
BASELINE_MODEL_PATH=guard/models/baseline_classifier.joblib
CLASSIFIER_MODEL_PATH=guard/models/intent_classifier

# Security settings
MAX_PROMPT_LENGTH=2000
# one of: low, medium, high
SANITIZATION_LEVEL=medium
LOG_LEVEL=INFO

# API server
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated keys required in the X-API-Key header. Leave blank to disable auth.
API_KEYS=
